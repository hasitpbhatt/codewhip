{
  "name": "codewhip",
  "version": "0.3.0",
  "description": "Model-agnostic terminal coding agent — policy-checked loop, signed audit trail, metered receipts, free-provider chain",
  "author": "Hasit Bhatt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasitpbhatt/codewhip.git"
  },
  "bugs": {
    "url": "https://github.com/hasitpbhatt/codewhip/issues"
  },
  "homepage": "https://github.com/hasitpbhatt/codewhip#readme",
  "type": "module",
  "bin": {
    "codewhip": "dist/index.js"
  },
  "files": [
    "dist",
    "tasks",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "test": "tsx --test src/**/*.test.ts",
    "bench": "tsx src/bench/cli.ts",
    "serve": "node dist/serve.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "codewhip",
    "coding-agent",
    "cli",
    "agent",
    "openai",
    "llm",
    "router",
    "audit",
    "policy",
    "typescript",
    "esm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "opentui": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "opentui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
