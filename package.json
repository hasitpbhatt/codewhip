{
  "name": "codewhip",
  "version": "0.3.0",
  "description": "Model-agnostic terminal coding agent — policy-checked loop, signed audit trail, metered receipts, free-provider chain",
  "author": "Hasit Bhatt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasitpbhatt/codewhip.git"
  },
  "bugs": {
    "url": "https://github.com/hasitpbhatt/codewhip/issues"
  },
  "homepage": "https://github.com/hasitpbhatt/codewhip#readme",
  "type": "module",
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./proxy": {
      "import": "./dist/lib/proxy.js",
      "require": "./dist/lib/proxy.js",
      "types": "./dist/lib/proxy.d.ts"
    },
    "./storage": {
      "import": "./dist/lib/storage.js",
      "require": "./dist/lib/storage.js",
      "types": "./dist/lib/storage.d.ts"
    },
    "./providers": {
      "import": "./dist/lib/providers.js",
      "require": "./dist/lib/providers.js",
      "types": "./dist/lib/providers.d.ts"
    },
    "./openai": {
      "import": "./dist/lib/openai.js",
      "require": "./dist/lib/openai.js",
      "types": "./dist/lib/openai.d.ts"
    },
    "./types": {
      "import": "./dist/lib/types.js",
      "require": "./dist/lib/types.js",
      "types": "./dist/lib/types.d.ts"
    }
  },
  "files": [
    "dist",
    "tasks",
    "workers",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codewhip": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:lib": "tsc --project tsconfig.lib.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc --noEmit --project tsconfig.lib.json",
    "lint": "oxlint src --deny-warnings",
    "test": "tsx --test src/**/*.test.ts",
    "test:lib": "tsx --test src/lib/**/*.test.ts",
    "bench": "tsx src/bench/cli.ts",
    "serve": "node dist/serve.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler dev"
  },
  "keywords": [
    "codewhip",
    "coding-agent",
    "cli",
    "agent",
    "openai",
    "llm",
    "router",
    "audit",
    "policy",
    "typescript",
    "esm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "opentui": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "opentui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^3.105.0"
  }
}
